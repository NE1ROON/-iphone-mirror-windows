{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iPhone Mirror",
  "version": "1.0.0",
  "identifier": "com.iphone-mirror.windows",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "iPhone Mirror Settings",
        "width": 420,
        "height": 380,
        "resizable": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": true
    },
    "longDescription": "Wrapper for MirrorDrop/AirPlay receivers to make iPhone mirroring window frameless, always-on-top, and draggable on Windows.",
    "licenseFile": "LICENSE",
    "copyright": "MIT License"
  },
  "plugins": {
    "store": { "filename": "settings.json" },
    "autostart": { "macos": { "launchAgent": { "enabled": false } } },
    "windowState": { "enabled": true }
  }
}